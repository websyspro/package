{
  "name": "websyspro/package",
  "version": "1.0.6",
  "description": "Version Management",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "license": "MIT",
  "type": "library",
  "autoload": {
    "psr-4": {
      "Websyspro\\Package\\": "src/"
    }
  },
  "bin": [
    "bin/publish"
  ],  
  "scripts": {
    "git:push": "git add . && git commit -m \"Update components\" && git push origin HEAD",
    "git:pull": "git pull origin main"
  },
  "authors": [
    {
      "name": "websyspro",
      "email": "websyspro.services@gmail.com"
    }
  ],
  "require": {
    "websyspro/utils": "^1.0"
  }
}
